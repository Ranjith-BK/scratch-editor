{
  "include": ["src", "../scratch-vm/src"],
  "compilerOptions": {
    /* Visit https://aka.ms/tsconfig to read more about this file */

    /* Language and Environment */
    "target": "ESNext",
    "jsx": "react",

    /* Modules */
    "module": "commonjs",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": false,
    "baseUrl": ".",
    "paths": {
      "@scratch/scratch-vm": ["../scratch-vm/src/index.js"]
    },
    "types": ["./src/types.d.ts"],

    /* Emit */
    "declaration": true,
    "sourceMap": true,
    "outDir": "./dist/types/",

    /* Interop Constraints */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,

    /* Type Checking */
    "strict": true,
    "noImplicitAny": false,

    /* Completeness */
    "skipLibCheck": true
  }
}
